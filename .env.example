# ============================================
# Sheen 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- OpenAI ----
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- 飞书（可选） ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=

# ---- 钉钉（可选） ----
DINGTALK_TOKEN=
DINGTALK_AES_KEY=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# ---- 数据库 ----
SQLITE_DB_PATH=data/memory.db

# ---- 记忆配置 ----
SHORT_TERM_MAX_MESSAGES=20
LONG_TERM_RETRIEVAL_TOP_K=3

# ---- 日志 ----
LOG_LEVEL=DEBUG

# ---- 网络搜索（Tavily API，可选） ----
TAVILY_API_KEY=

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000

# ---- Agent ----
AGENT_MAX_ITERATIONS=5